# EditorConfig — https://editorconfig.org
# One source of truth for whitespace and encoding, so diffs stay about content.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Two trailing spaces are a hard line break in Markdown — do not strip them.
[*.md]
trim_trailing_whitespace = false

# Machine-generated by npm; let the tool own its formatting.
[package-lock.json]
trim_trailing_whitespace = unset
insert_final_newline = unset
